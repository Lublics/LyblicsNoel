# Cache-Control pour les assets statiques
<IfModule mod_expires.c>
    ExpiresActive On

    # Images : 30 jours
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png  "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/gif  "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"

    # CSS / JS : 7 jours
    ExpiresByType text/css         "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType text/javascript  "access plus 7 days"

    # Polices : 1 an (rarement modifiees)
    ExpiresByType font/woff  "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"

    # HTML : pas de cache (contenu dynamique)
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    # Header Cache-Control pour les images
    <FilesMatch "\.(jpe?g|png|webp|gif|svg|ico)$">
        Header set Cache-Control "public, max-age=2592000, immutable"
    </FilesMatch>

    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>

    # Securite
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Bloquer l'acces direct au dossier data/
RewriteEngine On
RewriteRule ^data/ - [F,L]

# Bloquer l'acces direct aux fichiers cachés
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
